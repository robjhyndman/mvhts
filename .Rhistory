max_punkte <- 0
complete_team <- function(n, print_team = FALSE, return_team = FALSE){
# falls ich schonmal Punkte für alle Teams ausgerechnet habe
if(exists("gitter_ordered")){
dummy2 <- race[gitter_ordered[n,],]
# dummy_points <- erg_sorted[n]
}
else{
dummy2 <- race[gitter_numbers[n,],]
}
budget <- 100 - sum(dummy2$Cost)
driver9 <- top_n(dplyr::filter(race, Cost <= budget, number %nin% dummy2$number), 1, Points)
out <- rbind(dummy2, driver9[1,])
# falls diese Punktzahl groesser als das bisherige maximum ist,
# wird dieses ueberschrieben und das Team geprintet
if(sum(out$Points) >= max_punkte){
max_punkte <<- sum(out$Points)
print(out)
print(paste("Neue Maximalpunktzahl in Iteration", n, "von", dim(subset_aff)[1], ":", sum(out$Points), "Punkte."))
}
if(dim(out)[1] != 9){
print(paste("More than nine drivers in line", n,"choosen!"))
}
if(print_team){
print(out)
}
if(return_team){
return(out)
}
return(sum(out$Points))
}
complete_team(1, TRUE)
erg_teams <- sapply(1:dim(subset_aff)[1], complete_team)
# -> 2. Berechnung approx. 30 minutes
# oder 2. Berechnung auf dem Server, dann laden:
# load("H:/Simulation_velogames/erg_velogames2_giro25.RData")
