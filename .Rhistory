library(dplyr)
library(scales)
library(readxl)
library("rvest")
# Punktetabelle auf Homepage automatisch aus R heraus scrapen
# HTMLLink <- "https://www.velogames.com/velogame/2024/riders.php"
HTMLLink <- "https://www.velogames.com/spain/2026/riders.php"
HTMLContent <- read_html(HTMLLink)
HTMLContent %>% html_nodes("#post-935 > div > table > tbody") %>% html_table() -> race1
race <- race1[[1]]
colnames(race) <- c("Image", "Name", "Team", "Class", "Cost", "Choosen", "Points")
race$number <- 1:184
race$ratio <- race$Points / race$Cost
###
`%nin%` = Negate(`%in%`)
race
View(race)
myteam <- race[c(1, 88, 30, 18, 11, 129, 32, 123, 34),]
myteam
table(race$Class)
# Bedingungen:
# 2 All-Rounder, 2 Climber, 1 Sprinter, 3 Unclassed, 1 Wild Card
# Cost <= 100
choose(11, 2) * choose(17, 2) * choose(22, 1) * choose(134, 3) * nrow(race)
table(dplyr::filter(race, Class == "Climber")$Cost)
# Wir müssen nicht alle 4 All Rounder mit Cost 8 beachten, da die zwei mit
# mehr Punkten immer bevorzugt werden. -> Also nur noch 2 All Rounder mit
# gleichem Preis, 2 Climber mit gleichem Preis, etc.
# Wildcard wird im Anschluss ausgewählt
vec_choose <- NULL
vec_slots <- NULL
for(i in c("All Rounder", "Climber", "Sprinter", "Unclassed")){
dummy <- table(dplyr::filter(race, Class == i)$Cost)
if(i == "Sprinter"){
sum_x <- sum(apply(dummy, 1, function(X)min(X, 1)))
print(paste("Für Class", i, "stehen", sum_x, "Fahrer zur Auswahl."))
vec_slots <- c(vec_slots, sum_x)
vec_choose <- c(vec_choose, choose(sum_x, 1))
}
else if(i == "Unclassed"){
sum_x <- sum(apply(dummy, 1, function(X)min(X, 3)))
print(paste("Für Class", i, "stehen", sum_x, "Fahrer zur Auswahl."))
vec_slots <- c(vec_slots, sum_x)
vec_choose <- c(vec_choose, choose(sum_x, 3))  }
else{
sum_x <- sum(apply(dummy, 1, function(X)min(X, 2)))
print(paste("Für Class", i, "stehen", sum_x, "Fahrer zur Auswahl."))
vec_slots <- c(vec_slots, sum_x)
vec_choose <- c(vec_choose, choose(sum_x, 2))
}
}
# Anzahl Kombinationen (ohne Wildcard):
prod(vec_choose)
# # Teilgruppen mit den meisten Punkten jeweils:
# allr <- rbind(filter(race, Class == "All Rounder", Cost >= 10),
#               top_n(filter(race, Class == "All Rounder", Cost == 8), 2, Points))
# climb <- rbind(filter(race, Class == "Climber", Cost >= 12),
#                top_n(filter(race, Class == "Climber", Cost == 10), 2, Points),
#                top_n(filter(race, Class == "Climber", Cost == 8), 2, Points),
#                top_n(filter(race, Class == "Climber", Cost == 6), 2, Points))
# sprint <- rbind(top_n(filter(race, Class == "Sprinter", Cost == 12), 1, Points),
#                top_n(filter(race, Class == "Sprinter", Cost == 10), 1, Points),
#                top_n(filter(race, Class == "Sprinter", Cost == 8), 1, Points),
#                top_n(filter(race, Class == "Sprinter", Cost == 6), 1, Points))
# uncl <- rbind(top_n(filter(race, Class == "Unclassed", Cost == 8), 3, Points),
#                 top_n(filter(race, Class == "Unclassed", Cost == 6), 3, Points),
#                 top_n(filter(race, Class == "Unclassed", Cost == 4), 3, Points))
# im folgenden am Ende vom Befehlt number oder Points auswaehlen
## Points falls schon Punkte vergeben wurden
## number vor dem Rennen (zur Bestimmung der Anzahl an Kombinationen)
dummy_riders <- dplyr::filter(race, Class == "All Rounder")
allr <- NULL
for(k in unique(dummy_riders$Cost)){
allr <- rbind(allr, top_n(dplyr::filter(dummy_riders, Cost == k), 2, Points))
}
dummy_riders <- dplyr::filter(race, Class == "Climber")
climb <- NULL
for(k in unique(dummy_riders$Cost)){
climb <- rbind(climb, top_n(dplyr::filter(dummy_riders, Cost == k), 2, Points))
}
dummy_riders <- dplyr::filter(race, Class == "Sprinter")
sprint <- NULL
for(k in unique(dummy_riders$Cost)){
sprint <- rbind(sprint, top_n(dplyr::filter(dummy_riders, Cost == k), 1, Points))
}
dummy_riders <- dplyr::filter(race, Class == "Unclassed")
uncl <- NULL
for(k in unique(dummy_riders$Cost)){
uncl <- rbind(uncl, top_n(dplyr::filter(dummy_riders, Cost == k), 3, Points))
}
# Check: Tabellen = berechnete Dimensionen?
all(c(NROW(allr), NROW(climb), NROW(sprint), NROW(uncl)) == vec_slots)
c_allr <- combn(allr$number, 2)
c_climb <- combn(climb$number, 2)
c_sprint <- sprint$number
c_uncl <- combn(uncl$number,3)
gitter <- expand.grid("row_allr" = 1:NCOL(c_allr),
"row_climb" = 1:NCOL(c_climb),
"row_spr" = 1:vec_slots[3],
"row_uncl" = 1:NCOL(c_uncl))
# save(file = "H:/Simulation_velogames/Daten_velogames_vuelta24.RData",
#      race, allr, climb, sprint, uncl,
#      c_allr, c_climb, c_uncl, gitter)
# Berechne die Kosten fuer jede Kombination an möglichen Fahrern:
get_costs <- function(n){
# dummy1 <- rbind(allr[c_allr[, gitter[n,1]],],
#                climb[c_climb[, gitter[n,2]],],
#                sprint[gitter[n,3],],
#                uncl[c_uncl[, gitter[n,4]],])
dummy1 <- race[c(c_allr[,gitter[n,1]], c_climb[,gitter[n,2]],
c_sprint[gitter[n,3]], c_uncl[,gitter[n,4]]),]
sum(dummy1$Cost)
}
# -> 1. Berechnung:
costs_all <- sapply(1:dim(gitter)[1], get_costs)
