highlight_class <- function(myclass, write_names = FALSE){
dummy_riders <- dplyr::filter(race, Class == myclass)
points(dummy_riders$Cost, dummy_riders$Points, pch = 16,
col = which(c("All Rounder", "Climber", "Sprinter", "Unclassed") == myclass))
if(write_names){
text(dummy_riders$Cost, dummy_riders$Points, dummy_riders$Name, adj = -0.1,
col = which(c("All Rounder", "Climber", "Sprinter", "Unclassed") == myclass))
}
}
